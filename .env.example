# Server Environment & Port
ENV=production
PORT=8088

# PostgreSQL with pgvector
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_library
DB_SSLMODE=disable

# Authentication
JWT_SECRET=fabric-stock-library-super-secret-jwt-key-2026
JWT_EXPIRATION_HOURS=72

# AWS S3 Storage (Fabric Swatch Uploads)
AWS_REGION=eu-central-1
AWS_S3_ACCESS_KEY=your_aws_access_key
AWS_S3_KEY_SECRET=your_aws_secret_key
AWS_S3_BUCKET=pantoneclosbucket
