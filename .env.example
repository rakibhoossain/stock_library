# Database (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stock_library
DB_SSLMODE=disable

# Authentication
JWT_SECRET=fabric-stock-library-super-secret-jwt-key-2026
JWT_EXPIRATION_HOURS=72

# AWS S3 Storage (for swatch image uploads)
AWS_REGION=eu-central-1
AWS_S3_ACCESS_KEY=your_aws_access_key
AWS_S3_KEY_SECRET=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name

# Deployment Ports & Communication URLs
WEB_PORT=3050
BACKEND_PORT=8088
INTERNAL_BACKEND_URL=http://backend:8088
# Leave empty for automatic same-domain proxying (/api/v1), or set explicit URL:
NEXT_PUBLIC_API_URL=
