# Nginx configuration for Fabric Stock Library at /var/www/stock_library
# Symlink or copy to /etc/nginx/sites-available/stock_library
# ln -s /etc/nginx/sites-available/stock_library /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name fabric.matrixglobalplatform.com;

    # Root directory pointing to the static Next.js export
    root /var/www/stock_library/web/out;
    index index.html;

    # Allow high-resolution swatch image uploads
    client_max_body_size 50M;

    # Gzip compression for fast static delivery
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # 1. Reverse Proxy for Go API running in Docker (:8088)
    location /api/ {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # 2. Immutable caching for Next.js hashed JS/CSS assets
    location /_next/static/ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 3. Static media caching (logo.png, icons, fonts)
    location ~* \.(ico|png|jpg|jpeg|svg|webp|woff2?|ttf)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    # 4. Static Next.js frontend pages and SPA routing
    location / {
        # Tries exact file -> Next.js pre-rendered HTML ($uri.html) -> directory -> SPA root
        try_files $uri $uri.html $uri/ /index.html;
    }
}
